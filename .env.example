# Google OAuth (obrigatório)
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# Banco de dados MySQL (Railway preenche automaticamente)
DATABASE_URL=mysql://user:password@host:3306/dbname

# Segredo para assinar os cookies de sessão (gere uma string aleatória longa)
JWT_SECRET=uma-string-secreta-longa-e-aleatoria

# URL pública do app (Railway preenche automaticamente ou configure manualmente)
APP_URL=https://seu-app.railway.app

# Node
NODE_ENV=production

# Metabase — condutas GERCON (server/syncMetabase.ts)
# URL base do Metabase (sem barra no final, sem VPN institucional o Railway não alcança isso)
METABASE_URL=https://metabase.telessauders.ufrgs.br:3000
# ID da Question/card salva no Metabase (ex: .../question/961-... → 961)
METABASE_CARD_ID=961
# Autenticação — use API Key (opção a) OU email/senha de uma conta de serviço (opção b)
# a) API Key (se o Metabase tiver esse recurso habilitado):
METABASE_API_KEY=
# b) login e senha (usado se METABASE_API_KEY não estiver definida):
METABASE_EMAIL=
METABASE_PASSWORD=
